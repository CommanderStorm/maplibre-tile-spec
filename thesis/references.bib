@article{fujimuraDESIGNDEVELOPMENTVECTOR2019,
  title = {{{UN}} Vector Tile Toolkit},
  author = {Fujimura, H. and Martin Sanchez, O. and Gonzalez Ferreiro, D. and Kayama, Y. and Hayashi, H. and Iwasaki, N. and Mugambi, F. and Obukhov, T. and Motojima, Y. and Sato, T.},
  date = {2019-08-23},
