\NeedsTeXFormat{LaTeX2e}
\ProvidesPackage{listings-maplibre}[2026/05/24 MapLibre style spec highlighting]

\RequirePackage{listings}
\RequirePackage{xcolor}

% Semantic role aliases onto the Okabe-Ito CVD-safe palette defined in main.tex.
\colorlet{mlOperator}{cvdblue}
\colorlet{mlProperty}{cvdvermillion}
\colorlet{mlLiteral}{cvdpurple}

\lstdefinelanguage{MapLibreStyle}{%
  sensitive=true,
  alsoletter={"-!=<>\#},
  morecomment=[l]{//},
  morecomment=[s]{/*}{*/},
  %
  % [1] Operators: quoted function-like tokens in JSON expressions.
  morekeywords=[1]{%
    "match","case","interpolate","interpolate-hcl","interpolate-lab","step",%
    "get","has","!has","at","in","!in","length","literal","var","let",%
    "all","any","!","==","!=","<","<=",">",">=",%
    "concat","downcase","upcase","to-string","to-number","to-boolean","to-color",%
    "zoom","heatmap-density","line-progress","feature-state","geometry-type","id",%
    "coalesce","typeof"%
  },
  %
  % [2] Property keys (unquoted in the YAML-style snippets used in the thesis).
  morekeywords=[2]{%
    type,source,source-layer,filter,layout,paint,minzoom,maxzoom,id,%
    fill-color,fill-opacity,fill-outline-color,fill-pattern,%
    line-color,line-width,line-opacity,line-dasharray,line-cap,line-join,%
    circle-radius,circle-color,circle-stroke-width,circle-stroke-color,%
    text-field,text-size,text-color,text-font,text-halo-color,text-halo-width,%
    icon-image,icon-size,icon-color,icon-allow-overlap,%
    visibility,stops,base%
  },
  %
  % [3] Bare-word literals.
  morekeywords=[3]{true,false,null}%
}

\lstdefinestyle{maplibrestyle}{%
  language=MapLibreStyle,
  basicstyle=\ttfamily,
  keywordstyle=[1]\color{mlOperator}\bfseries,
  keywordstyle=[2]\color{mlProperty},
  keywordstyle=[3]\color{mlLiteral}\itshape,
  identifierstyle=\color{mlLiteral},
  commentstyle=\color[gray]{0.4}\itshape,
  columns=fullflexible,
  keepspaces=true,
  showstringspaces=false,
}

% Inline macros for prose: mirror the block-level highlighting so a mention of
% e.g. \mlop{match} in the text matches its colour inside listings.
\newcommand{\mlop}[1]{\texttt{\textcolor{mlOperator}{#1}}}
\newcommand{\mlprop}[1]{\texttt{\textcolor{mlProperty}{#1}}}
\newcommand{\mlval}[1]{\texttt{\textcolor{mlLiteral}{#1}}}
