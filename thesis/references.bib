@article{yuAssessmentMapStyleInfluence2024,
  title = {An {{Assessment}} of the {{Map-Style Influence}} on {{Generalization}} with {{CycleGAN}}: {{Taking Line Features}} as an {{Example}}},
  shorttitle = {An {{Assessment}} of the {{Map-Style Influence}} on {{Generalization}} with {{CycleGAN}}},
  author = {Yu, Heng and Chen, Haoxuan and Zhang, Ling},
  date = {2024-11-21},
  journaltitle = {IJGI},
  volume = {13},
